<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_elastic_form" model="ir.ui.view">
        <field name="name">stock.warehouse.elastic.form</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="elastic_inventory_enabled"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_elastic_list" model="ir.ui.view">
        <field name="name">stock.warehouse.elastic.list</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="elastic_inventory_enabled" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
