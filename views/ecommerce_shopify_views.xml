<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elastic_ecommerce_connection_form_shopify" model="ir.ui.view">
        <field name="name">elastic.ecommerce.connection.form.shopify</field>
        <field name="model">elastic.ecommerce.connection</field>
        <field name="inherit_id" ref="odoo-elastic-app.view_elastic_ecommerce_connection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='platform_credentials']" position="inside">
                <field name="shopify_shop_domain" placeholder="example.myshopify.com"
                       invisible="platform != 'shopify'" required="platform == 'shopify'"/>
                <field name="shopify_api_version"
                       invisible="platform != 'shopify'" required="platform == 'shopify'"/>
                <field name="shopify_access_token" password="True"
                       invisible="platform != 'shopify'"/>
            </xpath>
        </field>
    </record>
</odoo>
