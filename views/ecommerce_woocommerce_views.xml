<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elastic_ecommerce_connection_form_woocommerce" model="ir.ui.view">
        <field name="name">elastic.ecommerce.connection.form.woocommerce</field>
        <field name="model">elastic.ecommerce.connection</field>
        <field name="inherit_id" ref="odoo-elastic-app.view_elastic_ecommerce_connection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='platform_credentials']" position="inside">
                <field name="woocommerce_store_url" placeholder="https://shop.example.com"
                       invisible="platform != 'woocommerce'" required="platform == 'woocommerce'"/>
                <field name="woocommerce_consumer_key" password="True"
                       invisible="platform != 'woocommerce'"/>
                <field name="woocommerce_consumer_secret" password="True"
                       invisible="platform != 'woocommerce'"/>
            </xpath>
        </field>
    </record>
</odoo>
